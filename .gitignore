# macOS
.DS_Store

# Godot editor cache
.godot/
/android/

# GUT — the test framework is not part of the plugin. Install it from the
# Asset Library if you want to run the suite in test/. See docs/technical/.
addons/gut/

# godot-sqlite iOS binaries — 286 MB of xcframeworks, far too large to vendor.
# Install godot-sqlite from the Asset Library if you are exporting to iOS.
addons/godot-sqlite/bin/*.ios.*
addons/godot-sqlite/bin/libgodot-cpp.ios.*

# Tarinoi credentials (stored locally, never committed)
.tarinoi_credentials

# Bundled DB snapshots — generated by "Tarinoi: Snapshot for Export"
tarinoi/bundled/

# JetBrains
/.idea/

# Release zips built by tools/make_release_zip.sh
dist/
